# ------------------------------------------------------------------
# Copy this file to ".env" for local testing. NEVER commit ".env".
# On your host (Render, VPS, ...) set these as Environment Variables.
# ------------------------------------------------------------------

# Where the website is allowed to call this API from (comma separated, no trailing slash, no path).
ALLOWED_ORIGINS=https://absmartsolution.com.np,https://www.absmartsolution.com.np

# The Gmail account that SENDS the message and (by default) RECEIVES it.
GMAIL_USER=absmartsolution2026@gmail.com

# Optional: receive enquiries at a different address (comma separated). Defaults to GMAIL_USER.
# MAIL_TO=

# How to send: "smtp" (Gmail App Password) or "gmail-api" (OAuth2 over HTTPS).
MAIL_MODE=smtp

# --- MAIL_MODE=smtp ---
# 16-character Google App Password (Google Account > Security > 2-Step Verification > App passwords).
# This is NOT your normal Gmail password.
GMAIL_APP_PASSWORD=

# --- MAIL_MODE=gmail-api ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Server
PORT=3000
# Number of reverse proxies in front of this app. Render / most hosts = 1. Local testing = 0.
TRUST_PROXY=0
